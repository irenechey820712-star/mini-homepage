rules_version = '2';

/* 미요Lab 한줄평(방명록) 보안 규칙입니다.
   로그인 없이 누구나 한 줄을 남길 수 있고, 남기면 바로 공개됩니다.
   대신 아래 조건으로 형태를 제한해 아무 데이터나 넣지 못하게 막습니다.

   - 필드는 author, text, approved, createdAt 네 개만 허용
   - 이름 20자, 본문 100자 제한
   - createdAt 은 클라이언트가 정할 수 없고 서버 시간만 허용
   - 한 번 쓴 글은 클라이언트에서 수정·삭제 불가 (콘솔에서만 삭제)

   승인제로 바꾸려면: read 조건을 resource.data.approved == true 로 바꾸고,
   create 조건의 approved == true 를 approved == false 로 바꾸면 됩니다. */
service cloud.firestore {
  match /databases/{database}/documents {

    /* 사이트 소유자(미니홈피 주인)의 Firebase Auth UID 입니다.
       배포된 사이트에서 Google 로그인을 한 번 하면 편집바에 내 UID 가 표시됩니다.
       그 값으로 아래 문자열을 바꾸고, src/config/site.ts 의 OWNER_UID 도 같게 맞춘 뒤
       이 규칙을 다시 게시(Publish)하세요. */
    function ownerUid() {
      return "J9MEA0BeTfZ1ET0TPDazz9Bzq112";
    }
    function isOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    /* 편집 가능한 사이트 콘텐츠입니다. 누구나 읽고, 소유자만 씁니다. */
    match /site/content {
      allow read: if true;
      allow write: if isOwner();
    }

    match /guestbook/{entryId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['author', 'text', 'approved', 'createdAt'])
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 1
        && request.resource.data.author.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 100
        && request.resource.data.approved == true
        && request.resource.data.createdAt == request.time;

      /* 소유자는 수정·삭제(모더레이션) 가능 */
      allow update, delete: if isOwner();
    }

    /* 방글라데시 코너입니다. 영어·벵골어 메시지를 누구나 남길 수 있습니다.
       - 필드는 author, text, createdAt 세 개만 허용 (이름 40자, 본문 500자)
       - createdAt 은 서버 시간만 허용, 수정·삭제는 콘솔에서만 */
    match /bangladesh/{entryId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['author', 'text', 'createdAt'])
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 1
        && request.resource.data.author.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;

      /* 소유자는 수정·삭제(모더레이션) 가능 */
      allow update, delete: if isOwner();
    }

    /* AIEDAP 실습 결과물 게시판입니다. 연수생이 누구나 자신의 실습 결과(단계·소감·결과물 링크)를 남길 수 있습니다.
       - 필드는 author, step, text, link, createdAt 다섯 개만 허용 (link 는 선택 — 없어도 됨)
       - 이름 40자, 실습 단계 60자, 소감/결과 500자, 링크 300자 제한
       - createdAt 은 서버 시간만 허용, 수정·삭제는 소유자만 */
    match /practiceBoard/{entryId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['author', 'step', 'text', 'link', 'createdAt'])
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 1
        && request.resource.data.author.size() <= 40
        && request.resource.data.step is string
        && request.resource.data.step.size() >= 1
        && request.resource.data.step.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && (!('link' in request.resource.data)
          || (request.resource.data.link is string && request.resource.data.link.size() <= 300))
        && request.resource.data.createdAt == request.time;

      /* 소유자는 수정·삭제(모더레이션) 가능 */
      allow update, delete: if isOwner();
    }

    /* 미니홈피 왼쪽 위 TODAY / TOTAL 방문 수입니다. 문서 하나만 씁니다.

       - 한 번에 total 을 1씩만 올릴 수 있습니다
       - 날짜(day)가 바뀐 첫 방문이면 today 는 1로 돌아갑니다
       - 필드는 total, today, day 세 개만 허용하고 삭제는 막습니다

       day 문자열이 진짜 오늘인지는 규칙에서 확인하지 못합니다.
       조작하더라도 today 가 1로 리셋되는 정도이고 total 은 영향받지 않습니다. */
    match /counters/site {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['total', 'today', 'day'])
        && request.resource.data.total == 1
        && request.resource.data.today == 1
        && request.resource.data.day is string;

      allow update: if request.resource.data.keys().hasOnly(['total', 'today', 'day'])
        && request.resource.data.total is int
        && request.resource.data.today is int
        && request.resource.data.day is string
        && request.resource.data.total == resource.data.total + 1
        && (
          (request.resource.data.day == resource.data.day
            && request.resource.data.today == resource.data.today + 1)
          || (request.resource.data.day != resource.data.day
            && request.resource.data.today == 1)
        );

      allow delete: if false;
    }

    /* 그 밖의 모든 경로는 차단합니다. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
